{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "riskveille",
  "account_id": "60a28fd434f41c12130eaae8b3906e25",
  "main": "worker.js",
  "compatibility_date": "2025-09-27",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./.cloudflare-package/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "riskveille-db",
      "database_id": "b4c177cc-0805-43a1-bef1-204d4ec40b3e",
      "migrations_dir": "migrations"
    }
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
